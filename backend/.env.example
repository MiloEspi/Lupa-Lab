# Copiá este archivo como .env para desarrollo.
DEBUG=True
DATABASE_URL=postgres://lupalab:lupalab@localhost:5433/lupalab
FRONTEND_URL=http://localhost:5173
# Archivos: 'local' guarda en backend/archivos-locales. En producción:
# ARCHIVOS_BACKEND=r2, R2_ENDPOINT, R2_BALDE, R2_CLAVE, R2_SECRETO.
ARCHIVOS_BACKEND=local
# En producción: SECRET_KEY, ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS y un EMAIL_BACKEND real.
